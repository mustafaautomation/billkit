# Billkit runs with no environment variables. Set any of these to leave mock mode.
# Never commit real values. Copy this file to .env.local.

# Session signing for mock mode. Required in production if you are not using Supabase Auth.
SESSION_SECRET=

# Supabase. All three are required together. The anon key is public; the service role is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode. Leave blank to use the in-app mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend. Leave blank to keep messages in the in-app inbox.
RESEND_API_KEY=
RESEND_FROM=

# Optional reminder copy. Groq is preferred when both are set.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Set to 1 only in CI or local Playwright. Exposes POST /api/test/reset.
BILLKIT_E2E=
